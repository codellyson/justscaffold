{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "__PRODUCT_NAME__",
  "version": "0.1.0",
  "identifier": "com.example.__CRATE_NAME__",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "__PRODUCT_NAME__",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
