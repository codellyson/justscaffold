{
  // The builder page is a Worker serving only static assets — no script, so no
  // `main`. The name has to stay `justscaffold`: it is what binds this config
  // to the existing Worker, and with it the custom domain. Renaming it would
  // deploy a second Worker and leave the domain pointed at the old one.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "justscaffold",
  "compatibility_date": "2026-08-16",
  "assets": {
    // Generated by `npm run gen:web`, not committed — deploying without that
    // build serves an index.html whose registry.js 404s and whose every
    // dynamic panel is empty.
    "directory": "./web"
  }
}
